    (:reset-pose (&optional (limbs '(:torso :lleg :rleg :larm :rarm)))
      "Predefined pose named reset-pose."
      (unless (listp limbs) (setq limbs (list limbs)))
      (dolist (limb limbs)
        (case limb
          (:torso (send self limb :angle-vector (float-vector 0.000000 0.000000 0.000000)))
          (:lleg (send self limb :angle-vector (float-vector 0.000000 0.000000 0.000000 0.000000 0.000000 0.000000)))
          (:rleg (send self limb :angle-vector (float-vector 0.000000 0.000000 0.000000 0.000000 0.000000 0.000000)))
          (:larm (send self limb :angle-vector (float-vector 0.000000 0.000000 0.000000 0.000000 0.000000 0.000000 0.000000)))
          (:rarm (send self limb :angle-vector (float-vector 0.000000 0.000000 0.000000 0.000000 0.000000 0.000000 0.000000)))
          (t (format t "Unknown limb is passed: ~a~%" limb))))
      (send self :angle-vector))
