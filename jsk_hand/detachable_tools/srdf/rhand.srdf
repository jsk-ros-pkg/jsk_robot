<?xml version="1.0"?>
<!-- Named positions of the rhand hand motor (<side>_joint, rad) for each tool -->
<robot name="rhand">
  <group name="rhand_generic">
    <joint name="rhand_joint" />
  </group>
  <group name="rhand_gripper">
    <joint name="rhand_joint" />
  </group>
  <group name="rhand_needle_holder">
    <joint name="rhand_joint" />
  </group>
  <group name="rhand_forceps">
    <joint name="rhand_joint" />
  </group>
  <group name="rhand_yubi">
    <joint name="rhand_joint" />
  </group>
  <group_state name="open" group="rhand_generic">
    <joint name="rhand_joint" value="0.0" />
  </group_state>
  <group_state name="close" group="rhand_generic">
    <joint name="rhand_joint" value="-1.5" />
  </group_state>
  <group_state name="open" group="rhand_gripper">
    <joint name="rhand_joint" value="0.0" />
  </group_state>
  <group_state name="close" group="rhand_gripper">
    <joint name="rhand_joint" value="-1.5" />
  </group_state>
  <group_state name="open" group="rhand_needle_holder">
    <joint name="rhand_joint" value="-1.87" />
  </group_state>
  <group_state name="close" group="rhand_needle_holder">
    <joint name="rhand_joint" value="1.0" />
  </group_state>
  <group_state name="open" group="rhand_forceps">
    <joint name="rhand_joint" value="-2.2" />
  </group_state>
  <group_state name="close" group="rhand_forceps">
    <joint name="rhand_joint" value="-3.0" />
  </group_state>
  <group_state name="open_scissors" group="rhand_forceps">
    <joint name="rhand_joint" value="-0.8" />
  </group_state>
  <group_state name="close_scissors" group="rhand_forceps">
    <joint name="rhand_joint" value="-0.1" />
  </group_state>
</robot>
