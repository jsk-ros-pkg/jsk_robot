<launch>
  <arg name="side" default="lhand" description="Hand side: lhand or rhand" />
  <arg name="namespace" default="$(var side)" />
  <arg name="tool" default="generic" description="Tool: generic, needle_holder, gripper, forceps" />
  <arg name="attached" default="true" />
  <arg name="detected_ids" default="unspecified" />
  <arg name="include_detacher" default="true" description="Activate the detacher motor" />
  <arg name="port_name" default="/dev/$(var side)" />
  <arg name="baud_rate" default="57600" />
  <arg name="protocol_version" default="2.0" />
  <arg name="controllers_file" default="$(find-pkg-share detachable_tools)/config/$(var side)/controllers.yaml" />
  <arg name="publish_static_tf" default="false" />
  <arg name="parent_frame" default="" />
  <arg name="root_frame" default="$(var side)_base_link" />
  <arg name="static_xyz" default="0 0 0" />
  <arg name="static_rpy" default="0 0 0" />
  <arg name="robot_description_cmd"
       default="$(command 'ros2 run detachable_tools print_robot_description.py --side $(var side) --tool $(var tool) --attached $(var attached) --include-detacher $(var include_detacher) --port-name $(var port_name) --baud-rate $(var baud_rate) --protocol-version $(var protocol_version)')" />

  <!-- every tool is a hardware component; modular_hand_manager publishes control_description and loads the controllers -->
  <node pkg="controller_manager" exec="ros2_control_node"
        name="controller_manager" namespace="$(var namespace)" output="screen">
    <param from="$(var controllers_file)" />
    <remap from="robot_description" to="control_description" />
  </node>

  <node pkg="robot_state_publisher" exec="robot_state_publisher"
        name="robot_state_publisher" namespace="$(var namespace)" output="screen">
    <param name="robot_description" value="$(var robot_description_cmd)" />
    <remap from="joint_states" to="display_joint_states" />
  </node>

  <node pkg="detachable_tools" exec="modular_hand_manager.py"
        name="modular_hand_manager" namespace="$(var namespace)" output="screen"
        args="--side $(var side) --tool $(var tool) --attached $(var attached) --include-detacher $(var include_detacher) --port-name $(var port_name) --baud-rate $(var baud_rate) --protocol-version $(var protocol_version) --detected-ids=$(var detected_ids)" />

  <node pkg="detachable_tools" exec="joint_state_coupling_relay.py"
        name="joint_state_coupling_relay" namespace="$(var namespace)" output="screen"
        args="--joint-states-source-topic joint_states --joint-states-topic display_joint_states" />

  <node if="$(var publish_static_tf)"
        pkg="detachable_tools" exec="static_transform_publisher_xyz_rpy.py"
        name="tool_mount_static_tf" namespace="$(var namespace)" output="screen"
        args="--xyz $(var static_xyz) --rpy $(var static_rpy) --frame-id $(var parent_frame) --child-frame-id $(var root_frame)" />
</launch>
