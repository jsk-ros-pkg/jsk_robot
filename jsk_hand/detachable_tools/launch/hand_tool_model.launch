<launch>
  <!-- ROS 1 only, kept for compatibility: use hand_model.launch -->
  <arg name="side" default="rhand" doc="Hand side: lhand or rhand" />
  <arg name="namespace" default="$(arg side)" />
  <arg name="tool" default="generic" doc="End-effector tool: generic, needle_holder, gripper, forceps" />
  <arg name="joint_states_source_topic" default="joint_states_source" />
  <arg name="joint_states_topic" default="joint_states" />
  <arg name="publish_static_tf" default="false" />
  <arg name="parent_frame" default="" />
  <arg name="root_frame" default="$(eval arg('side') + '_base_link')" />
  <arg name="static_xyz" default="0 0 0" />
  <arg name="static_rpy" default="0 0 0" />
  <arg name="static_tf_period" default="100" doc="Unused: the static transform is latched" />
  <arg name="robot_description_file" default="" />
  <arg name="couplings_file" default="" doc="Unused: the display couplings are embedded in robot_description" />

  <include file="$(find detachable_tools)/launch/hand_model.launch">
    <arg name="side" value="$(arg side)" />
    <arg name="namespace" value="$(arg namespace)" />
    <arg name="tool" value="$(arg tool)" />
    <arg name="joint_states_source_topic" value="$(arg joint_states_source_topic)" />
    <arg name="joint_states_topic" value="$(arg joint_states_topic)" />
    <arg name="publish_static_tf" value="$(arg publish_static_tf)" />
    <arg name="parent_frame" value="$(arg parent_frame)" />
    <arg name="root_frame" value="$(arg root_frame)" />
    <arg name="static_xyz" value="$(arg static_xyz)" />
    <arg name="static_rpy" value="$(arg static_rpy)" />
    <arg name="robot_description_file" value="$(arg robot_description_file)" />
  </include>
</launch>
