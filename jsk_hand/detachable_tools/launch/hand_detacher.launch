<launch>
  <!-- ROS 1 counterpart of hand_detacher.launch.xml: detacher only, tools can be set later -->
  <arg name="side" default="lhand" doc="Hand side: lhand or rhand" />
  <arg name="namespace" default="$(arg side)" />
  <arg name="port_name" default="/dev/$(arg side)" />
  <arg name="baud_rate" default="57600" />
  <arg name="protocol_version" default="2.0" />
  <arg name="controllers_file" default="$(find detachable_tools)/config/$(arg side)/ros1/detacher_controllers.yaml" />
  <!-- ROS 1 only -->
  <arg name="control_rate" default="50" />

  <include file="$(find detachable_tools)/launch/hand_control.launch">
    <arg name="side" value="$(arg side)" />
    <arg name="namespace" value="$(arg namespace)" />
    <arg name="tool" value="detacher" />
    <arg name="attached" value="false" />
    <arg name="port_name" value="$(arg port_name)" />
    <arg name="baud_rate" value="$(arg baud_rate)" />
    <arg name="protocol_version" value="$(arg protocol_version)" />
    <arg name="controllers_file" value="$(arg controllers_file)" />
    <arg name="control_rate" value="$(arg control_rate)" />
  </include>
</launch>
