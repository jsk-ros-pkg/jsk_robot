<?xml version="1.0"?>
<robot name="lhand_detacher_robot">

  <link name="lhand_base_link">
    <visual>
      <geometry>
        <box size="0.2 0.2 0.2"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>

  <link name="lhand_detach_link_0">
    <visual>
      <origin rpy="0 0 0" xyz="0.12 0 0.05"/>
      <geometry>
        <box size="0.08 0.08 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
  </link>

  <!--
    Detacher motor that is always connected to the robot side.
    The detachable hand motor is intentionally not described here.
  -->
  <joint name="lhand_detach_joint_0" type="continuous">
    <origin rpy="0 0 0" xyz="0.1 0 0.1"/>
    <parent link="lhand_base_link"/>
    <child link="lhand_detach_link_0"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.0" velocity="6.8"/>
  </joint>

  <transmission name="lhand_detach_trans_0">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="lhand_detach_joint_0">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <offset>0.0</offset>
    </joint>
    <actuator name="lhand_detach_motor_0">
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
  </transmission>


  <!-- Dynamixel motor (ros2_control, dynamixel_hardware_interface) -->
  <ros2_control name="lhand_detacher" type="system">
    <hardware>
      <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>
      <param name="port_name">/dev/lhand</param>
      <param name="baud_rate">57600</param>
      <param name="number_of_joints">1</param>
      <param name="number_of_transmissions">1</param>
      <param name="dynamixel_model_folder">/param/dxl_model</param>
      <param name="disable_torque_at_init">true</param>
      <param name="error_timeout_ms">1000</param>
      <param name="dynamixel_state_pub_msg_name">detacher/dxl_state</param>
      <param name="get_dynamixel_data_srv_name">detacher/get_dxl_data</param>
      <param name="set_dynamixel_data_srv_name">detacher/set_dxl_data</param>
      <param name="reboot_dxl_srv_name">detacher/reboot_dxl</param>
      <param name="set_dxl_torque_srv_name">detacher/set_dxl_torque</param>
      <param name="protocol_version">2.0</param>
      <param name="initialize_communication_on_configure">true</param>
    </hardware>
    <gpio name="lhand_detach_motor_0">
      <param name="ID">0</param>
      <param name="type">dxl</param>
      <param name="Return Delay Time">0</param>
      <param name="Operating Mode">0</param>
      <param name="Torque Enable">1</param>
      <param name="[unit info]">Present Current,0.00115,N m,signed,0.0;Goal Current,0.00115,N m,signed,0.0</param>
      <command_interface name="Goal Current" />
      <state_interface name="Present Position" />
      <state_interface name="Present Velocity" />
      <state_interface name="Present Current" />
    </gpio>
    <joint name="lhand_detach_joint_0">
      <command_interface name="effort" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
      <state_interface name="hardware_state" />
      <state_interface name="torque_enable" />
    </joint>
  </ros2_control>
</robot>
