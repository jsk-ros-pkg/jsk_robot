    <mimic joint="XL_XC_330_1__small_needle_holder_link1_1" multiplier="0.575693" offset="0" />
    <!-- mates: CONCENTRIC, COINCIDENT, CONCENTRIC, COINCIDENT -->
  </joint>
  <joint name="XL_XC_330_1__small_needle_holder_link1_1" type="revolute">
