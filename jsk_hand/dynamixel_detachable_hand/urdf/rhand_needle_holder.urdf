  <link name="rhand_command_link" />

  <link name="rhand_detach_link_0">
    <visual>
      <origin rpy="0 0 0" xyz="0.12 0 0.05"/>
      <geometry>
        <box size="0.08 0.08 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
  </link>

  <!--
    Keep the hardware/API joint name stable across detachable tools.
    The real needle-holder four-bar joints are driven from this joint by
    loop_coupling_relay.
  -->
  <joint name="rhand_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="rhand_base_link"/>
    <child link="rhand_command_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="2.0" velocity="6.8"/>
  </joint>

  <joint name="rhand_detach_joint_0" type="continuous">
    <origin rpy="0 0 0" xyz="0.1 0 0.1"/>
    <parent link="rhand_base_link"/>
    <child link="rhand_detach_link_0"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.0" velocity="6.8"/>
  </joint>

  <joint name="small_needle_hoder_base_1__XL_XC_330_1" type="fixed">
