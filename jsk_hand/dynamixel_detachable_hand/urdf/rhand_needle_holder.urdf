    <parent link="rhand_small_needle_hoder_base_1" />
    <child link="rhand_XL_XC_330_1" />
    <axis xyz="0 0 -1" />
    <!-- mates: COINCIDENT, CONCENTRIC, CONCENTRIC, COINCIDENT, CONCENTRIC, CONCENTRIC -->
