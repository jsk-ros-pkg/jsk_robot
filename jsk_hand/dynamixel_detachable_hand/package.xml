<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dynamixel_detachable_hand</name>
  <version>0.1.0</version>
  <description>Interface for dynamixel detachable modules; controller and eusLisp/python utilities.</description>
  <maintainer email="tsubaki@jsk.t.u-tokyo.ac.jp">Michitoshi Tsubaki</maintainer>
  <license>BSD-3-Clause</license>
  <author email="tsubaki@jsk.t.u-tokyo.ac.jp">Michitoshi Tsubaki</author>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake_python</buildtool_depend>
  <buildtool_depend>ros_environment</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">jsk_ros1_ros2_compat</buildtool_depend>
  <exec_depend condition="$ROS_VERSION == 2">jsk_ros1_ros2_compat</exec_depend>

  <depend>control_msgs</depend>
  <exec_depend>controller_manager</exec_depend>
  <depend>diagnostic_msgs</depend>
  <exec_depend>dynamixel_sdk</exec_depend>
  <exec_depend>effort_controllers</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <depend>roseus</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>tf2_ros</exec_depend>
  <depend>trajectory_msgs</depend>
  <exec_depend>xacro</exec_depend>

  <exec_depend condition="$ROS_VERSION == 1">actionlib</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">actionlib_msgs</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">controller_manager_msgs</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">dynamixel_general_hw</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">joint_state_controller</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">position_controllers</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">python3-rospkg</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rosgraph</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rosnode</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rospy</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rostopic</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">cv_bridge</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">python3-matplotlib</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">python3-opencv</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rosgraph_msgs</exec_depend>

  <depend condition="$ROS_VERSION == 2">action_msgs</depend>
  <exec_depend condition="$ROS_VERSION == 2">ament_index_python</exec_depend>
  <depend condition="$ROS_VERSION == 2">builtin_interfaces</depend>
  <exec_depend condition="$ROS_VERSION == 2">dynamixel_hardware_interface</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">dynamixel_interfaces</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">joint_state_broadcaster</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">controller_manager_msgs</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">lifecycle_msgs</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">parallel_gripper_controller</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">launch_ros</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">launch_xml</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">ros2launch</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">ros2run</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">rcl_interfaces</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">rclpy</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">tf2_ros_py</exec_depend>
  <!-- surgenoid_needle_holder_display.launch.py -->
  <exec_depend condition="$ROS_VERSION == 2">joint_state_publisher_gui</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">python3-numpy</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">rviz2</exec_depend>

  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
